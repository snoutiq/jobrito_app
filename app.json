{
  "expo": {
    "name": "jobrito",
    "slug": "jobconnect-hospitality-workforce",
    "scheme": "jobrito",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/Jobrito full logo.png",
    "splash": {
      "image": "./src/assets/Jobrito full logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jobrito.app",
      "buildNumber": "3",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleDisplayName": "jobrito",
        "CFBundleName": "jobrito",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Jobrito requires camera access to allow you to take and upload a profile picture and business verification documents.",
        "NSPhotoLibraryUsageDescription": "Jobrito requires photo library access to allow you to select and upload your profile photo and business logos.",
        "NSPhotoLibraryAddUsageDescription": "Jobrito requires permission to save photos to your library.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "icon": "./src/assets/Jobrito full logo.png",
      "entitlements": {
        "aps-environment": "production"
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.jobrito.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/Jobrito full logo.png",
        "backgroundColor": "#ffffff"
      },
      "runtimeVersion": "1.0.0"
    },
    "web": {},
    "extra": {
      "eas": {
        "projectId": "23b73f60-8028-44a1-b6e6-9699b62c2190"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Jobrito requires access to your photos to allow you to upload profile pictures and business logos.",
          "cameraPermission": "Jobrito requires camera access to take profile photos directly from the app."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/Jobrito full logo.png",
          "color": "#153e69",
          "sounds": []
        }
      ],
      "expo-secure-store",
      "expo-video"
    ],
    "updates": {
      "url": "https://u.expo.dev/23b73f60-8028-44a1-b6e6-9699b62c2190"
    }
  }
}
